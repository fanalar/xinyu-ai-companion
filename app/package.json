{
  "name": "xinyu-lover",
  "version": "1.4.1",
  "description": "心屿 · AI恋人 桌面版",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.xinyu.lover",
    "productName": "心屿AI恋人",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/pkg/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "心屿 · AI恋人",
      "artifactName": "心屿AI恋人_全面优化版_v${version}_安装包.exe",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
